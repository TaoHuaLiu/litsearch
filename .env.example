# Copy to .env and fill in. Sources whose key is missing are skipped.

# OpenAlex: no key needed; an email gives access to the faster "polite pool".
OPENALEX_EMAIL=
OPENALEX_API_KEY=

# Google Scholar via SerpAPI  https://serpapi.com/
SERPAPI_KEY=

# IEEE Xplore  https://developer.ieee.org/
IEEE_API_KEY=

# ScienceDirect / Elsevier  https://dev.elsevier.com/  (insttoken only if Elsevier gave you one)
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=
